# ==========================================
# Railway Environment Variables Configuration
# Copy estas variables a tu proyecto Railway
# ==========================================

# ==========================================
# 🔴 OBLIGATORIAS - Backend NO arrancará sin estas
# ==========================================

# Database Configuration (Railway MySQL provee estas automáticamente)
# Opción A: Usar DATABASE_URL de Railway
SPRING_DATASOURCE_URL=${DATABASE_URL}
SPRING_DATASOURCE_USERNAME=${MYSQLUSER}
SPRING_DATASOURCE_PASSWORD=${MYSQLPASSWORD}

# Opción B: Construir URL manualmente (usar si Opción A falla)
# SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQLHOST}:${MYSQLPORT}/${MYSQLDATABASE}?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=${MYSQLUSER}
# SPRING_DATASOURCE_PASSWORD=${MYSQLPASSWORD}

# JWT Configuration (⚠️ GENERAR CLAVE SEGURA!)
# Genera con: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_SECURE_KEY_MINIMUM_256_BITS_USE_OPENSSL_RAND_BASE64_64
JWT_EXPIRATION_DAYS=7

# Server Port (Railway asigna automáticamente)
PORT=8080

# ==========================================
# 🟡 RECOMENDADAS - Para producción optimizada
# ==========================================

# JPA/Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Logging (menos verbose en producción)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_HIBERNATE_SQL=WARN
LOGGING_LEVEL_HIBERNATE_BINDER=WARN

# ==========================================
# 🟢 OPCIONALES - Configuración avanzada
# ==========================================

# CORS Configuration (ajustar a tu dominio frontend)
# CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-frontend.railway.app

# Application Name
# SPRING_APPLICATION_NAME=chronicare-backend

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. Las variables ${MYSQLHOST}, ${MYSQLPORT}, etc. son provistas automáticamente por Railway MySQL
# 2. NO hardcodees passwords o secrets aquí - usa el dashboard de Railway
# 3. Genera JWT_SECRET seguro: openssl rand -base64 64
# 4. En desarrollo local, usa application.properties con valores por defecto
